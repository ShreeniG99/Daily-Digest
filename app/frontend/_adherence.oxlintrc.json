{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/icon/**",
              "ui_kits/daily-digest/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Merriweather))/i]",
        "message": "Font not provided by the design system. Available: Inter, Merriweather."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|solid|label|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: kind, solid, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|icon|iconRight|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, icon, iconRight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|title|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: variant, icon, title, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:empty|loading|error)$/]",
        "message": "<EmptyState> variant must be one of 'empty' | 'loading' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|bordered|active|accent|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, bordered, active, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DigestItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|kind|source|title|url|author|published_ts|raw_text|tags|domain|score|status|key|ref|className|style|children)$/]",
        "message": "<DigestItem> doesn't accept that prop. Declared props: id, kind, source, title, url, author, published_ts, raw_text, tags, domain, score, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='DigestItem'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:news|youtube|paper|repo|opportunity)$/]",
        "message": "<DigestItem> kind must be one of 'news' | 'youtube' | 'paper' | 'repo' | 'opportunity'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DigestItem'] > JSXAttribute[name.name='domain'] > Literal[value!=/^(?:ai|tech|fintech|healthtech|agrotech)$/]",
        "message": "<DigestItem> domain must be one of 'ai' | 'tech' | 'fintech' | 'healthtech' | 'agrotech'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DigestItem'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:new|read|saved)$/]",
        "message": "<DigestItem> status must be one of 'new' | 'read' | 'saved'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreSignal'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|max|showNumber|showLabel|key|ref|className|style|children)$/]",
        "message": "<ScoreSignal> doesn't accept that prop. Declared props: score, max, showNumber, showLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|count|key|ref|className|style|children)$/]",
        "message": "<SegOption> doesn't accept that prop. Declared props: value, label, icon, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:domain|keyword|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: domain, keyword."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|className|key|ref|className|style|children)$/]",
        "message": "<ThemeToggle> doesn't accept that prop. Declared props: checked, onChange, label, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
